rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function canDeleteOpenedCapsule(capsuleId) {
      let capsule = firestore.get(/databases/(default)/documents/capsules/$(capsuleId));
      return request.auth != null
        && capsule.data.ownerUid == request.auth.uid
        && capsule.data.openAt is timestamp
        && capsule.data.openAt <= request.time;
    }

    match /capsules/{capsuleId}/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if canDeleteOpenedCapsule(capsuleId);
    }
  }
}
